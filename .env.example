# LLM API Keys
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...
OPENAI_API_KEY=sk-...

# Default LLM: "claude" | "deepseek"
DEFAULT_LLM=claude

# Database
DB_URL=sqlite+aiosqlite:///data/memory.db

# ChromaDB
CHROMA_PERSIST_DIR=data/chroma

# SEO Platform APIs (optional — tools work in mock mode without these)
# GOOGLE_CREDENTIALS_FILE=/path/to/service-account-key.json
# GSC_SITE_URL=https://www.example.com
# PAGESPEED_API_KEY=              # Free: 50K requests/day without key
# SEMRUSH_API_KEY=
